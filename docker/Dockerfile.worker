# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────
# Dockerfile.worker — Python Worker/Job Runner
# Image: apps/api (worker entrypoint)
# ─────────────────────────────────────────────────────────────

FROM python:3.12-slim AS builder
WORKDIR /build

RUN pip install --no-cache-dir uv==0.4.27

COPY apps/api/pyproject.toml apps/api/uv.lock* ./
RUN uv sync --frozen --no-dev

FROM python:3.12-slim AS runner
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN addgroup --system --gid 1001 workergroup && \
    adduser --system --uid 1001 --ingroup workergroup workeruser

COPY --from=builder /build/.venv /app/.venv
COPY apps/api/app ./app

ENV PATH="/app/.venv/bin:$PATH"
ENV WORKSPACE_DATA_DIR=/data/workspace

RUN mkdir -p /data/workspace /data/manifests /tmp/jobs && \
    chown -R workeruser:workergroup /data /tmp/jobs

USER workeruser
EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD python -c "print('worker ok')" || exit 1

# Worker listens on a job queue from PostgreSQL
CMD ["/app/.venv/bin/python", "-m", "app.runner.worker"]
